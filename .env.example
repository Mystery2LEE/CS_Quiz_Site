# Anthropic API 키 (https://console.anthropic.com 에서 발급) - 관리자가 문제 생성 시 사용
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# 관리자 로그인 비밀번호 (직접 정하기 - 팀원에게는 공유하지 않기)
ADMIN_PASSWORD=여기에_원하는_비밀번호

# 아래 두 개는 Vercel에서 Upstash Redis(또는 KV) 스토리지를 프로젝트에 연결하면 자동으로 채워집니다.
# 로컬 개발 시에만 직접 입력하면 됩니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=
